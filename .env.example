SECRET_KEY=replace-with-a-strong-secret
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
TIME_ZONE=Africa/Algiers

POWERBI_REPORT_SERVER_URL=http://pbirs.example.local
POWERBI_REPORT_SERVER_URLS=http://pbirs.example.local,http://pbirs-secondary.example.local

LDAP_SERVER_NAME=ldap.example.local
LDAP_DOMAIN=EXAMPLE
LDAP_SEARCH_BASE=DC=example,DC=local
LDAP_PORT=636
LDAP_USE_SSL=True
LDAP_CA_CERT_FILE=
LDAP_CONNECT_TIMEOUT=8
LDAP_RECEIVE_TIMEOUT=20
LDAP_ENABLE_PORT_FALLBACK=False
LDAP_SERVER_ALTERNATES=
MOBILE_LOGIN_RATE_LIMIT_PER_IP=100
MOBILE_LOGIN_RATE_LIMIT_PER_USER=10
MOBILE_LOGIN_RATE_LIMIT_WINDOW=900
# Set only if the trusted proxy strips client-supplied values and overwrites this header.
MOBILE_LOGIN_CLIENT_IP_HEADER=
# Mobile app (docs/MOBILE_API.md). Sessions slide: they expire after N days without use.
MOBILE_SESSION_DAYS=30
# Older app versions get a blocking "Mise à jour requise" dialog pointing to the download URL.
MOBILE_MIN_APP_VERSION=3.0.0
MOBILE_LATEST_APP_VERSION=3.0.0
MOBILE_APP_DOWNLOAD_URL=
MOBILE_CONTACT_EMAIL=cbi@groupe-hasnaoui.com
MOBILE_CONTACT_PHONE=3004
MOBILE_WEBSITE_URL=https://cbi.groupe-hasnaoui.com
MOBILE_NOTIFICATION_POLL_SECONDS=60
LDAP_SERVICE_USERNAME=
LDAP_SERVICE_PASSWORD=
PBIRS_SYNC_ON_LOGIN=False
PBIRS_REFRESH_STATUS_LIVE=False
PBIRS_REFRESH_STATUS_MAX_REPORTS=40
PBIRS_REFRESH_STATUS_TIMEOUT=2
PBIRS_REFRESH_STATUS_MAX_SECONDS=20
PBIRS_SYNC_POLICY_TIMEOUT=15
PBIRS_SYNC_POLICY_RETRIES=2
PBIRS_SYNC_POLICY_RETRY_DELAY=1.5
PBIRS_SYNC_POLICY_REQUEST_DELAY=0.05
PBIRS_SYNC_MAX_WORKERS=20


LDAP_GROUP_MEMBERS_URL=
LDAP_API_TOKEN=

DB_ENGINE=postgresql
DB_NAME=cbi_db
DB_USER=cbi_user
DB_PASSWORD=replace-with-db-password
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Local development only. Production must use a shared atomic cache or ingress throttling.
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=unique-snowflake

SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_AGE=28800
SESSION_EXPIRE_AT_BROWSER_CLOSE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
USE_X_FORWARDED_PROTO=False
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DATA_UPLOAD_MAX_MEMORY_SIZE=6291456
